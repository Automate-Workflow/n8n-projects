# Normalize line endings to LF for cross-platform consistency
* text=auto eol=lf

# Documentation and configuration
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cff text eol=lf
*.json text eol=lf
*.csv text eol=lf

# Source code and scripts
*.py text eol=lf
*.sh text eol=lf

# SVG assets are XML text files
*.svg text eol=lf

# Git and editor config
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
LICENSE text eol=lf
CODEOWNERS text eol=lf

# Binary image formats (if ever added)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
